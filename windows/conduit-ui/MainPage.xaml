<Page x:Class="Conduit.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wuc="using:CommunityToolkit.WinUI.Controls"
      Background="Transparent"
      Loaded="MainPage_Loaded" Unloaded="MainPage_Unloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Keep the native caption buttons, drag surface and single-instance shell behavior. -->
        <Grid x:Name="TitleBarRoot" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="246" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0" Spacing="9">
                <Image x:Name="TitleBarIcon" Width="25" Height="25" />
                <TextBlock Text="Conduit" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1,0,0,1">
                <TextBlock Text="YOUR DEVICE, CLOSE AT HAND" Margin="34,0,0,0" FontSize="10"
                           CharacterSpacing="90" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="246" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Mica-backed Windows Fluent surfaces. Preserve the existing layout and all handlers. -->
            <Border Background="Transparent"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16,24,16,18" RowSpacing="19">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="13" Padding="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="80" CornerRadius="9"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <Grid>
                                    <Image Source="{Binding WallpaperSource}" Stretch="UniformToFill" />
                                    <Border Width="15" Height="3" CornerRadius="2"
                                            Background="{ThemeResource TextFillColorTertiaryBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="PAIRED DEVICE" FontSize="10" FontWeight="SemiBold"
                                           CharacterSpacing="75" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding DeviceName}" FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="{Binding ConnectionGlyph}" FontSize="11"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding ConnectionState}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Spacing="5">
                        <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold"
                                   CharacterSpacing="100" Margin="12,0,0,9"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Grid Height="44">
                            <Border x:Name="NotificationsNavHighlight" CornerRadius="9"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Button Style="{StaticResource ConduitNavigationButtonStyle}"
                                    Click="ShowNotifications_Click" AutomationProperties.Name="Notifications">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="17" />
                                    <TextBlock Text="Notifications" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NotificationsNavAccent" Width="3" Height="23" CornerRadius="2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                        </Grid>
                        <Grid Height="44">
                            <Border x:Name="LinksNavHighlight" CornerRadius="9" Visibility="Collapsed"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Button Style="{StaticResource ConduitNavigationButtonStyle}" Click="ShowSharedLinks_Click"
                                    AutomationProperties.Name="Shared links">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE71B;" FontSize="17" />
                                    <TextBlock Text="Shared links" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="LinksNavAccent" Width="3" Height="23" CornerRadius="2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Height="44">
                            <Border x:Name="SettingsNavHighlight" CornerRadius="9" Visibility="Collapsed"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Button Style="{StaticResource ConduitNavigationButtonStyle}" Click="ShowSettings_Click"
                                    AutomationProperties.Name="Settings">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE713;" FontSize="17" />
                                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="SettingsNavAccent" Width="3" Height="23" CornerRadius="2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Height="44">
                            <Border x:Name="AboutNavHighlight" CornerRadius="9" Visibility="Collapsed"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Button Style="{StaticResource ConduitNavigationButtonStyle}" Click="ShowAbout_Click"
                                    AutomationProperties.Name="About Conduit">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE946;" FontSize="17" />
                                    <TextBlock Text="About" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="AboutNavAccent" Width="3" Height="23" CornerRadius="2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Spacing="12">
                        <Button x:Name="SendFileButton" Style="{StaticResource ConduitAccentButtonStyle}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Click="SendFile_Click" ToolTipService.ToolTip="Send file to phone">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE72D;" FontSize="16" />
                                <TextBlock Text="Send a file" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" Padding="5,12,5,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding ConnectionRoute}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="End-to-end encrypted" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="1" Visibility="{Binding TransfersVisibility}" Margin="38,0,38,18" Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                    <StackPanel Spacing="9">
                        <TextBlock Text="File transfers" FontSize="14" FontWeight="SemiBold" />
                        <ScrollViewer MaxHeight="174" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsRepeater ItemsSource="{Binding Transfers}">
                                <ItemsRepeater.Layout><StackLayout Spacing="12" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Outcome}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percentage}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Cancel" Tag="{Binding Id}" Click="CancelTransfer_Click"
                                                    Visibility="{Binding CancelVisibility}" IsEnabled="{Binding CanCancel}"
                                                    AutomationProperties.Name="{Binding CancelName}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Grid x:Name="NotificationsPage" Margin="38,26,38,26" RowSpacing="17">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Notifications" FontSize="29" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Updates from your phone, all in one place." FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0"
                                Style="{StaticResource ConduitGhostButtonStyle}"
                                Click="ClearNotifications_Click" IsEnabled="{Binding HasNotifications}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                <TextBlock Text="Clear all" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="15,11" CornerRadius="11">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{Binding ConnectionGlyph}" FontSize="15"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding ConnectionState}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding ConnectionRoute}" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource ConduitGhostButtonStyle}"
                                    VerticalAlignment="Center" Click="Refresh_Click"
                                    ToolTipService.ToolTip="Refresh connection status">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,9,0">
                        <ItemsRepeater ItemsSource="{Binding Notifications}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="9" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="17,15" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="12">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="40" Height="40" VerticalAlignment="Top">
                                                <Border CornerRadius="10" Background="{ThemeResource ControlFillColorDefaultBrush}" />
                                                <FontIcon Glyph="&#xE7F4;" FontSize="19"
                                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <Image Width="35" Height="35" Source="{Binding IconSource}"
                                                       Stretch="Uniform" VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <Grid>
                                                    <TextBlock Text="{Binding App}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,56,0" />
                                                    <TextBlock Text="{Binding Age}" FontSize="11" HorizontalAlignment="Right"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Body}" FontSize="13" TextWrapping="Wrap"
                                                           MaxLines="3" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <Border x:Name="DropZone" Grid.Row="3" AllowDrop="True"
                            DragOver="DropZone_DragOver" Drop="DropZone_Drop"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="19,15">
                        <Grid ColumnSpacing="13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE898;" FontSize="20" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Drop files here to share" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Or use Send a file in the sidebar to choose a file." FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="SharedLinksPage" Visibility="Collapsed" Margin="38,26,38,28" RowSpacing="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Shared links" FontSize="29" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Links shared between your devices." FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0"
                                Style="{StaticResource ConduitGhostButtonStyle}"
                                Click="ClearLinks_Click" IsEnabled="{Binding HasLinks}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                <TextBlock Text="Clear all" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Padding="14,12" CornerRadius="10"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock Text="Select a link to open it in your browser." FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <ListView x:Name="SharedLinksList" Grid.Row="2" ItemsSource="{Binding SharedLinks}"
                              IsItemClickEnabled="True" SelectionMode="None" ItemClick="SharedLinksList_ItemClick"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        Padding="18,15" CornerRadius="11" Margin="0,3,7,6">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Url}" FontSize="12"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="14"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>


                <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="38,26,38,24" RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="SettingsSectionTitle" Text="Settings" FontSize="29" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="SettingsSectionSubtitle" Text="Make Conduit work the way you like." FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid Grid.Row="1">

                                    <ScrollViewer x:Name="GeneralSettingsPanel"
                                                  Padding="0,0,14,28"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  HorizontalScrollMode="Disabled">
                                        <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                            <TextBlock Text="Connection &amp; preferences" Margin="0,0,0,12" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                            <wuc:SettingsCard Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8" Header="Paired phone" Description="{Binding PairingSummary}">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8EA;" /></wuc:SettingsCard.HeaderIcon>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button Content="{Binding PairActionLabel}" Click="PairDevice_Click" />
                                                    <Button Content="Forget" IsEnabled="{Binding HasPairedDevice}" Click="ForgetDevice_Click" />
                                                </StackPanel>
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8" Header="Relay points" Description="Managed Conduit relays; LAN remains preferred when available">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE774;" /></wuc:SettingsCard.HeaderIcon>
                                                <StackPanel MinWidth="330" MaxWidth="410" Spacing="2">
                                                    <CheckBox Content="US  ·  conduit-us.414222.xyz" IsChecked="{Binding RelayUs, Mode=TwoWay}" />
                                                    <CheckBox Content="WA  ·  conduit-wa.414222.xyz" IsChecked="{Binding RelayWa, Mode=TwoWay}" />
                                                    <CheckBox Content="TYO  ·  conduit-tyo.414222.xyz" IsChecked="{Binding RelayTyo, Mode=TwoWay}" />
                                                    <CheckBox Content="JP  ·  conduit-jp.414222.xyz" IsChecked="{Binding RelayJp, Mode=TwoWay}" />
                                                    <TextBlock Text="{Binding RelaySummary}" Margin="4,4,0,0" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8" Header="Relay proxy" Description="System proxy, a manual SOCKS5 endpoint, or direct relay access">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE968;" /></wuc:SettingsCard.HeaderIcon>
                                                <StackPanel MinWidth="330" MaxWidth="410" Spacing="8">
                                                    <ComboBox ItemsSource="{Binding ProxyModes}" SelectedItem="{Binding ProxyMode, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                                    <TextBox Text="{Binding ManualProxy, Mode=TwoWay}" IsEnabled="{Binding ManualProxyEnabled}"
                                                             PlaceholderText="socks5://127.0.0.1:1080" />
                                                    <TextBlock Text="{Binding SystemProxyDescription}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8" Header="Start at sign-in" Description="Start the background Conduit daemon when Windows signs in">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></wuc:SettingsCard.HeaderIcon>
                                                <ToggleSwitch IsOn="{Binding StartAtSignIn}" Toggled="AutostartToggle_Toggled" />
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8" Header="Send to phone in Explorer" Description="Add the Conduit file-send command to Explorer">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></wuc:SettingsCard.HeaderIcon>
                                                <ToggleSwitch IsOn="{Binding ExplorerIntegration}" Toggled="ExplorerToggle_Toggled" />
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8" Header="Tray icon" Description="Show the optional Conduit icon in the notification area">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F4;" /></wuc:SettingsCard.HeaderIcon>
                                                <ToggleSwitch IsOn="{Binding TrayIcon, Mode=TwoWay}" />
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8" Header="Received files" Description="{Binding ReceiveFolder}">
                                                <wuc:SettingsCard.HeaderIcon><SymbolIcon Symbol="Folder" /></wuc:SettingsCard.HeaderIcon>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Default" Click="ResetReceiveFolder_Click" />
                                                    <Button Content="Select location" Click="SelectReceiveFolder_Click" />
                                                </StackPanel>
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8" Header="Conduit data" Description="{Binding DataDirectory}">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE838;" /></wuc:SettingsCard.HeaderIcon>
                                                <Button Content="Open folder" Click="OpenDataFolder_Click" />
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8" Header="Diagnostics" Description="Connection and daemon status">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></wuc:SettingsCard.HeaderIcon>
                                                <Button Content="Show diagnostics" Click="OpenDiagnostics_Click" />
                                            </wuc:SettingsCard>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Spacing="12">
                                                <TextBlock x:Name="SaveStateText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Button Click="SaveSettings_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                                        <TextBlock Text="Save settings" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <ScrollViewer x:Name="AboutSettingsPanel"
                                                  Visibility="Collapsed"
                                                  Padding="0,0,14,28"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  HorizontalScrollMode="Disabled">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Version &amp; project" Margin="0,0,0,12" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                            <wuc:SettingsCard Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8" Header="Conduit" Description="{Binding ApplicationVersion}">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></wuc:SettingsCard.HeaderIcon>
                                            </wuc:SettingsCard>
