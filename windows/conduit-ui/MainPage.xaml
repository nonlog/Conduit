<Page
    x:Class="Conduit.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wuc="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent"
    Loaded="MainPage_Loaded"
    Unloaded="MainPage_Unloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarRoot" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="8">
                <Image Width="25" Height="25" Source="ms-appx:///Assets/conduit-icon.png" />
                <TextBlock Text="Conduit" VerticalAlignment="Center" FontSize="14" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="18,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="18" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="54" Height="100" CornerRadius="8"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="2" VerticalAlignment="Center">
                        <Border Margin="2" CornerRadius="5"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#0070FF" />
                                    <GradientStop Offset="1" Color="#2E90FF" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="{Binding ConnectionGlyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding ConnectionRoute}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="12,6" CornerRadius="4,0,0,4"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1,1,0,1">
                                <TextBlock Text="{Binding ConnectionState}" VerticalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="1" Padding="0" CornerRadius="0,4,4,0" Click="Refresh_Click"
                                    ToolTipService.ToolTip="Refresh status">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SendFileButton" Grid.Column="0" Height="36" Click="SendFile_Click" ToolTipService.ToolTip="Send file to phone">
                        <FontIcon Glyph="&#xE72D;" FontSize="16" />
                    </Button>
                    <Button Grid.Column="1" Height="36" Click="ShowSharedLinks_Click" ToolTipService.ToolTip="Shared links">
                        <FontIcon Glyph="&#xE71B;" FontSize="16" />
                    </Button>
                    <Button Grid.Column="2" Height="36" Click="ShowSettings_Click" ToolTipService.ToolTip="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                </Grid>

                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Rectangle Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="Notifications" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="8,4"
                                Click="ClearNotifications_Click" IsEnabled="{Binding HasNotifications}">
                            <TextBlock Text="Clear all" />
                        </Button>
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Row="3" Margin="0,0,-14,0" Padding="0,0,14,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsRepeater ItemsSource="{Binding Notifications}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Background="{ThemeResource CardBackgroundFillColorDefault}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1" CornerRadius="8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="48" Height="48" VerticalAlignment="Top">
                                            <Border CornerRadius="24" Background="{ThemeResource ControlFillColorDefaultBrush}" />
                                            <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Image Width="48" Height="48" Source="{Binding IconSource}" Stretch="Uniform" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <Grid>
                                                <TextBlock Text="{Binding App}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,42,0" />
                                                <TextBlock Text="{Binding Age}" FontSize="11" HorizontalAlignment="Right"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Body}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <NavigationView x:Name="MainNavigationView" Grid.Row="0" PaneDisplayMode="Top"
                                IsBackButtonVisible="Collapsed" IsSettingsVisible="True" BorderBrush="Transparent"
                                SelectionChanged="MainNavigationView_SelectionChanged">
                    <NavigationView.Resources>
                        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    </NavigationView.Resources>
                                <NavigationView.MenuItems>
                        <NavigationViewItem x:Name="SharedLinksNavigationItem" Content="Shared links" Tag="SharedLinks">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>
                </NavigationView>

                <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1,1,0,0" CornerRadius="10,0,0,0">
                    <Grid>
                        <Grid x:Name="SharedLinksPage" Margin="40,20,40,30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="Shared links" FontSize="28" FontWeight="SemiBold" />
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearLinks_Click" IsEnabled="{Binding HasLinks}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        <TextBlock Text="Clear all" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ListView x:Name="SharedLinksList" Grid.Row="1" Margin="0,22,0,0" ItemsSource="{Binding SharedLinks}"
                                      IsItemClickEnabled="True" SelectionMode="None" ItemClick="SharedLinksList_ItemClick"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,10" MinHeight="62">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Url}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                        <Grid x:Name="SettingsPage" Visibility="Collapsed">
                            <NavigationView x:Name="SettingsNavigation"
                                            BorderThickness="0"
                                            IsBackButtonVisible="Collapsed"
                                            IsPaneToggleButtonVisible="True"
                                            IsPaneOpen="False"
                                            IsSettingsVisible="False"
                                            PaneDisplayMode="LeftCompact"
                                            SelectionChanged="SettingsNavigation_SelectionChanged">
                                <NavigationView.PaneHeader>
                                    <TextBlock x:Name="SettingsPaneHeaderText" Text="Settings" Margin="24,16,0,16" FontSize="22" FontWeight="SemiBold" />
                                </NavigationView.PaneHeader>
                                <NavigationView.Resources>
                                    <Thickness x:Key="NavigationViewContentGridBorderThickness">1,0,0,0</Thickness>
                                    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                                </NavigationView.Resources>
                                <NavigationView.MenuItems>
                                    <NavigationViewItem x:Name="GeneralSettingsNavigationItem" Content="General" IsSelected="True" Tag="General"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
                                    <NavigationViewItem Content="About" Tag="About"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon></NavigationViewItem>
                                </NavigationView.MenuItems>
                                <Grid Padding="40,20,0,0">
                                    <ScrollViewer x:Name="GeneralSettingsPanel"
                                                  Padding="0,0,40,36"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  HorizontalScrollMode="Disabled">
                                        <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                            <TextBlock Text="General" Margin="0,0,0,8" FontSize="28" FontWeight="SemiBold" />
                                            <wuc:SettingsCard Header="Relay endpoints" Description="One endpoint per line or separate them with semicolons">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE774;" /></wuc:SettingsCard.HeaderIcon>
                                                <TextBox MinWidth="280" MaxWidth="360" Text="{Binding RelayEndpoints, Mode=TwoWay}" />
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Header="SOCKS5 proxy" Description="Relay-only proxy; LAN sessions stay direct">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE968;" /></wuc:SettingsCard.HeaderIcon>
                                                <TextBox MinWidth="280" MaxWidth="360" Text="{Binding Proxy, Mode=TwoWay}" />
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Header="Start at sign-in" Description="Start the background Conduit daemon when Windows signs in">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></wuc:SettingsCard.HeaderIcon>
                                                <ToggleSwitch IsOn="{Binding StartAtSignIn}" Toggled="AutostartToggle_Toggled" />
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Header="Send to phone in Explorer" Description="Add the Conduit file-send command to Explorer">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></wuc:SettingsCard.HeaderIcon>
                                                <ToggleSwitch IsOn="{Binding ExplorerIntegration}" Toggled="ExplorerToggle_Toggled" />
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Header="Tray icon" Description="Show the optional Conduit icon in the notification area">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F4;" /></wuc:SettingsCard.HeaderIcon>
                                                <ToggleSwitch IsOn="{Binding TrayIcon, Mode=TwoWay}" />
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Header="Received files" Description="{Binding ReceiveFolder}">
                                                <wuc:SettingsCard.HeaderIcon><SymbolIcon Symbol="Folder" /></wuc:SettingsCard.HeaderIcon>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Default" Click="ResetReceiveFolder_Click" />
                                                    <Button Content="Select location" Click="SelectReceiveFolder_Click" />
                                                </StackPanel>
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Header="Conduit data" Description="{Binding DataDirectory}">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE838;" /></wuc:SettingsCard.HeaderIcon>
                                                <Button Content="Open folder" Click="OpenDataFolder_Click" />
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Header="Diagnostics" Description="Connection and daemon status">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></wuc:SettingsCard.HeaderIcon>
                                                <Button Content="Show diagnostics" Click="OpenDiagnostics_Click" />
                                            </wuc:SettingsCard>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Spacing="12">
                                                <TextBlock x:Name="SaveStateText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Button Click="SaveSettings_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                                        <TextBlock Text="Save settings" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <ScrollViewer x:Name="AboutSettingsPanel"
                                                  Visibility="Collapsed"
                                                  Padding="0,0,40,36"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  HorizontalScrollMode="Disabled">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="About" Margin="0,0,0,8" FontSize="28" FontWeight="SemiBold" />
                                            <wuc:SettingsCard Header="Conduit" Description="Version 0.1.0">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></wuc:SettingsCard.HeaderIcon>
                                            </wuc:SettingsCard>
                                            <wuc:SettingsCard Header="GitHub repository" Description="nonlog/Conduit"
                                                              IsClickEnabled="True" Click="OpenRepository_Click">
                                                <wuc:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE774;" /></wuc:SettingsCard.HeaderIcon>
                                                <wuc:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" FontSize="14" /></wuc:SettingsCard.ActionIcon>
                                            </wuc:SettingsCard>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>

                            </NavigationView>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <InfoBar x:Name="StatusInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="520" Margin="24" />
    </Grid>
</Page>
