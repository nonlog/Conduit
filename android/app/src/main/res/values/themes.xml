<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints everything; the platform theme only has to get out of the way
         and follow the system light/dark setting. -->
    <style name="Theme.Conduit" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- The Compose light surface reaches behind the transparent system bars. Explicitly ask
             for dark glyphs; ColorOS otherwise keeps white status icons from the base DayNight
             theme and they disappear against the light dynamic-colour background. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
