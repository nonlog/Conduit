<?xml version="1.0" encoding="utf-8"?>
<!--
  Conduit accent gradient: violet into blue, top-left to bottom-right. Full-bleed 108dp
  because a launcher may crop, scale or
  parallax the background layer and any margin would show as a seam.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF6E5BD6" />
                <item android:offset="1" android:color="#FF2F6FE0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
