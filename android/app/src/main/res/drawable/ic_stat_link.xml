<?xml version="1.0" encoding="utf-8"?>
<!--
  The status bar tints this to a single colour and drops the alpha channel's shape into a
  24dp box, so it is the launcher glyph at 24dp with nothing else: no gradient, no fill,
  and a heavier relative stroke because 2/24 reads thinner than 9/108 does.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/colorControlNormal">

    <path
        android:pathData="M7,10 L16,10"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M14,8 L16,10 L14,12"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M17,14 L8,14"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M10,12 L8,14 L10,16"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
