<?xml version="1.0" encoding="utf-8"?>
<!--
  Two tracks, opposite directions: the app is bidirectional sync and nothing else, so the
  mark says exactly that. Deliberately only four strokes — the launcher renders this into
  a circle roughly 72dp across, where anything finer turns to mush.

  Drawn as stroked polylines rather than filled outlines so the weight is one number to
  tune, and kept inside a radius of 36 from centre (54,54) so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outbound -->
    <path
        android:pathData="M33,45 L72,45"
        android:strokeWidth="9"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M64,37 L72,45 L64,53"
        android:strokeWidth="9"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- inbound -->
    <path
        android:pathData="M75,63 L36,63"
        android:strokeWidth="9"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M44,55 L36,63 L44,71"
        android:strokeWidth="9"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
