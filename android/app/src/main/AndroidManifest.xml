<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- connectedDevice, not dataSync: dataSync is capped at 6 h on Android 15. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 14+ will not start a connectedDevice service on FOREGROUND_SERVICE_CONNECTED_DEVICE
         alone; it also demands one permission that proves an actual device is involved.
         Multicast is the honest one here, because mDNS discovery is exactly what we do. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- New camera photos become a Windows toast. Watched with a ContentObserver,
         never polled. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Conduit"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Conduit">

        <!-- LSPosed module metadata. The entry point is assets/xposed_init, and the scope
             array keeps ClipboardHook out of every process but system_server. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Lets Conduit read the clipboard while it is in the background" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Conduit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Read by the framework, not by us: it is what pairs the runtime shortcut
                 ShareTarget publishes with ShareActivity, so the share sheet's Direct Share
                 row shows the desktop's name rather than the manifest label "Conduit". -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- No UI at all: it reads the share intent, hands the URIs to the service and
             finishes, so the translucent theme is what the user never sees. The `*/*`
             filter is the fallback entry in the app list; the labelled Direct Share row
             above it is the shortcut's. -->
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ClipboardChangeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".ClipboardAccessibilityService"
            android:enabled="true"
            android:exported="false"
            android:label="Conduit clipboard sync"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/clipboard_accessibility" />
        </service>
        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <service
            android:name=".LinkTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_link"
            android:label="Conduit"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <!-- Serves the one cached clipboard image. Not exported, so a grant handed out by
             ClipboardManager when another app pastes is the only way to reach it. -->
        <provider
            android:name=".ImageProvider"
            android:authorities="com.conduit.sync.images"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Bound by the system, not by us, so it must be exported; the permission is
             what limits the binder to system_server. Enabling it is a user action in
             Settings -> Notification access. -->
        <service
            android:name=".NotificationRelay"
            android:exported="true"
            android:label="Conduit"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
